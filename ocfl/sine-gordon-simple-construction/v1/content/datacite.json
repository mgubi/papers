  "descriptions": [
    {
      "description": "We present a simple PDE construction of the sine-Gordon measure below the first threshold (${\\beta}^2 < 4\\pi$), in both the finite and infinite volume settings, by studying the corresponding parabolic sine-Gordon model. We also establish pathwise global well-posedness of the hyperbolic sine-Gordon model in finite volume for ${\\beta}^2 < 2\\pi$.",
      "descriptionType": "Abstract"
    }
