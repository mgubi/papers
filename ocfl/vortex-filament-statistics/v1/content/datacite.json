  "descriptions": [
    {
      "description": "A random field composed by Poisson distributed Brownian vortex filaments is constructed. The filament have a random thickness, length and intensity, governed by a measure $\\gamma$. Under appropriate assumptions on $\\gamma$ we compute the scaling law of the structure function and get the multifractal scaling as a particular case.",
      "descriptionType": "Abstract"
    }
