@article{brydges_branched_2003,
	title = {Branched polymers and dimensional reduction},
	volume = {158},
	issn = {0003-486X},
	url = {http://annals.math.princeton.edu/2003/158-3/p07},
	doi = {10.4007/annals.2003.158.1019},
	abstract = {We establish an exact relation between self-avoiding branched polymers in D + 2 continuum dimensions and the hard-core continuum gas at negative activity in D dimensions. We review conjectures and results on critical exponents for D + 2 = 2, 3, 4 and show that they are corollaries of our result. We explain the connection (ﬁrst proposed by Parisi and Sourlas) between branched polymers in D + 2 dimensions and the Yang-Lee edge singularity in D dimensions.},
	language = {en},
	number = {3},
	urldate = {2018-12-11},
