	Doi = {10.1007/s40072-013-0011-5},
	File = {Gubinelli and Jara - 2013 - Regularization by noise and stochastic Burgers equ.pdf:/Users/mgubi/Library/Application Support/Zotero/Profiles/tjzyruhi.default/zotero/storage/9TJTZ3V7/Gubinelli and Jara - 2013 - Regularization by noise and stochastic Burgers equ.pdf:application/pdf;Snapshot:/Users/mgubi/Library/Application Support/Zotero/Profiles/tjzyruhi.default/zotero/storage/T5FQGWCF/10.html:text/html},
	Issn = {2194-0401, 2194-041X},
