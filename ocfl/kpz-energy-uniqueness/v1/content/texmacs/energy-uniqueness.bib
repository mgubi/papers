	Keywords = {00X00, 35R60, 82B41, Computational Mathematics and Numerical Analysis, Computational Science and Engineering, Kardar--Parisi--Zhang equation, Noise regularization, Numerical Analysis, Partial Differential Equations, Probability Theory and Stochastic Processes, SPDEs, Statistical Theory and Methods},
