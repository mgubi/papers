@article{barashkovMultiscaleCouplingMaximum2023,
  title = {Multiscale {{Coupling}} and the {{Maximum}} of $\mathcal{P}(\varphi)_2$ on the {{Torus}}},
  author = {Barashkov, Nikolay and Gunaratnam, Trishen S. and Hofstetter, Michael},
