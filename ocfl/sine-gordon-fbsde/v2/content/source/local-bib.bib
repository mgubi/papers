@article{		  ohstochasticquantization$phi^3_3$model2021,
  title		= {Stochastic Quantization of the $\Phi_4^3$-Model},
  author	= {Oh, Tadahiro and Okamoto, Mamoru and Tolomeo, Leonardo},
  year		= 2021,
  number	= {arXiv:2108.06777},
  eprint	= {2108.06777},
  primaryclass	= {math-ph},
  publisher	= {arXiv},
  urldate	= {2023-11-01},
  abstract	= {(Due to the limit on the number of characters for an
		  abstract set by arXiv, the full abstract can not be
		  displayed here. See the abstract in the paper.) We study
		  the construction of the \$\textbackslash
		  Phi\textasciicircum 3\_3\$-measure and complete the program
		  on the (non-)construction of the focusing Gibbs measures,
		  initiated by Lebowitz, Rose, and Speer (1988). This problem
		  turns out to be critical, exhibiting the following phase
		  transition. In the weakly nonlinear regime, we prove
		  normalizability of the \$\textbackslash Phi\textasciicircum
		  3\_3\$-measure and show that it is singular with respect to
		  the massive Gaussian free field. Moreover, we show that
		  there exists a shifted measure with respect to which the
		  \$\textbackslash Phi\textasciicircum 3\_3\$-measure is
		  absolutely continuous. In the strongly nonlinear regime, by
		  further developing the machinery introduced by the authors
		  (2020), we establish non-normalizability of the
		  \$\textbackslash Phi\textasciicircum 3\_3\$-measure. Due to
		  the singularity of the \$\textbackslash Phi\textasciicircum
		  3\_3\$-measure with respect to the massive Gaussian free
		  field, this non-normalizability part poses a particular
		  challenge as compared to our previous works. In order to
		  overcome this issue, we first construct a \$\textbackslash
		  sigma\$-finite version of the \$\textbackslash
		  Phi\textasciicircum 3\_3\$-measure and show that this
		  measure is not normalizable. Furthermore, we prove that the
		  truncated \$\textbackslash Phi\textasciicircum
		  3\_3\$-measures have no weak limit in a natural space, even
		  up to a subsequence. We also study the dynamical problem.
		  By adapting the paracontrolled approach, in particular from
		  the works by Gubinelli, Koch, and the first author (2018)
		  and by the authors (2020), we prove almost sure global
		  well-posedness of the hyperbolic \$\textbackslash
		  Phi\textasciicircum 3\_3\$-model and invariance of the
		  Gibbs measure in the weakly nonlinear regime. In the
		  globalization part, we introduce a new, conceptually simple
		  and straightforward approach, where we directly work with
		  the (truncated) Gibbs measure, using the variational
		  formula and ideas from theory of optimal transport.},
  archiveprefix	= {arXiv},
  keywords	= {60H15 81T08 60L40 35L71 35K15,Mathematical
		  Physics,Mathematics - Analysis of PDEs,Mathematics -
		  Probability},
  file		= {/home/sarah/Zotero/storage/HE2642F8/Oh et al. - 2021 -
		  Stochastic quantization of the
		  $Phi^3_3$-model.pdf;/home/sarah/Zotero/storage/3N4QALZ6/2108.html}
}

