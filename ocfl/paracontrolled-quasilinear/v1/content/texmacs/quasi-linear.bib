@article{catellier_averaging_2016,
	title = {Averaging along irregular curves and regularisation of {ODEs}},
	volume = {126},
	issn = {0304-4149},
	url = {http://www.sciencedirect.com/science/article/pii/S0304414916000235},
	doi = {10.1016/j.spa.2016.02.002},
	abstract = {We consider the ordinary differential equation (ODE) d x t = b ( t , x t ) d t + d w t where w is a continuous driving function and b is a time-dependent vector field which possibly is only a distribution in the space variable. We quantify the regularising properties of an arbitrary continuous path w on the existence and uniqueness of solutions to this equation. In this context we introduce the notion of ρ -irregularity and show that it plays a key role in some instances of the regularisation by noise phenomenon. In the particular case of a function w sampled according to the law of the fractional Brownian motion of Hurst index H ∈ ( 0 , 1 ) , we prove that almost surely the ODE admits a solution for all b in the Besov–Hölder space B ∞ , ∞ α + 1 with α \&gt; − 1 / 2 H . If α \&gt; 1 − 1 / 2 H then the solution is unique among a natural set of continuous solutions. If H \&gt; 1 / 3 and α \&gt; 3 / 2 − 1 / 2 H or if α \&gt; 2 − 1 / 2 H then the equation admits a unique Lipschitz flow. Note that when α \&lt; 0 the vector field b is only a distribution, nonetheless there exists a natural notion of solution for which the above results apply.},
	number = {8},
	urldate = {2016-05-26},
	journal = {Stochastic Processes and their Applications},
	author = {Catellier, R. and Gubinelli, M.},
	month = aug,
	year = {2016},
	keywords = {fractional Brownian motion, Regularization by noise, Stochastic differential equation, Young integral},
	pages = {2323--2366},
	file = {Catellier and Gubinelli - 2016 - Averaging along irregular curves and regularisatio.pdf:/Users/mgubi/Library/Application Support/Zotero/Profiles/fm2dd0ng.default/zotero/storage/BA54T2JQ/Catellier and Gubinelli - 2016 - Averaging along irregular curves and regularisatio.pdf:application/pdf;ScienceDirect Snapshot:/Users/mgubi/Library/Application Support/Zotero/Profiles/fm2dd0ng.default/zotero/storage/N6UWQFQG/S0304414916000235.html:text/html}
}

@article{kelly_deterministic_2014,
	title = {Deterministic homogenization for fast-slow systems with chaotic noise},
	url = {http://arxiv.org/abs/1409.5748},
	abstract = {Consider a fast-slow system of ordinary differential equations of the form \${\textbackslash}dot x=a(x,y)+{\textbackslash}varepsilon{\textasciicircum}\{-1\}b(x,y)\$, \${\textbackslash}dot y={\textbackslash}varepsilon{\textasciicircum}\{-2\}g(y)\$, where it is assumed that \$b\$ averages to zero under the fast flow generated by \$g\$. We give conditions under which solutions \$x\$ to the slow equations converge weakly to an It{\textbackslash}{\textasciicircum}o diffusion \$X\$ as \${\textbackslash}varepsilon{\textbackslash}to0\$. The drift and diffusion coefficients of the limiting stochastic differential equation satisfied by \$X\$ are given explicitly. Our theory applies when the fast flow is Anosov or Axiom A, as well as to a large class of nonuniformly hyperbolic fast flows (including the one defined by the well-known Lorenz equations), and our main results do not require any mixing assumptions on the fast flow.},
	urldate = {2016-01-06},
	journal = {arXiv:1409.5748 [math]},
	author = {Kelly, D. and Melbourne, I.},
	month = sep,
	year = {2014},
	keywords = {60H10, 37D20, 37D25, 37A50, Mathematics - Dynamical Systems, Mathematics - Probability},
	annote = {Comment: 31 pages},
	file = {arXiv.org Snapshot:/Users/mgubi/Library/Application Support/Zotero/Profiles/fm2dd0ng.default/zotero/storage/EJEJ7GGF/1409.html:text/html;Kelly and Melbourne - 2014 - Deterministic homogenization for fast-slow systems.pdf:/Users/mgubi/Library/Application Support/Zotero/Profiles/fm2dd0ng.default/zotero/storage/FQB65ZPR/Kelly and Melbourne - 2014 - Deterministic homogenization for fast-slow systems.pdf:application/pdf}
}

 @article{hofmanova, title={Quasilinear generalized parabolic Anderson model equation}, url={http://arxiv.org/abs/1610.06726}, abstractNote={We present in this note a local in time well-posedness result for the singular $2$-dimensional quasilinear generalized parabolic Anderson model equation $$ partial_t u - a(u)Delta u = g(u)xi $$ The key idea of our approach is a simple transformation of the equation which allows to treat the problem as a semilinear problem. The analysis is done within the elementary setting of paracontrolled calculus.}, note={arXiv: 1610.06726}, journal={arXiv:1610.06726 [math]}, author={Bailleul, Ismael and Debussche, Arnaud and Hofmanova, Martina}, year={2016}, month={Oct}}


@article{otto_quasilinear_2016,
	title = {Quasilinear {SPDEs} via rough paths},
	url = {http://arxiv.org/abs/1605.09744},
	abstract = {We consider the variable-coefficient uniformly parabolic PDE {\textbackslash}begin\{equation*\} {\textbackslash}partial\_2u+a(u){\textbackslash}partial\_1{\textasciicircum}2u={\textbackslash}sigma(u)f {\textbackslash}end\{equation*\} with a right hand side \$f\$ which is only controlled in the low regularity norm of \$ C{\textasciicircum}\{{\textbackslash}alpha-2\}\$ for \${\textbackslash}alpha {\textgreater} {\textbackslash}frac\{2\}\{3\}\$ on the parabolic H{\textbackslash}"older scale. The example we have in mind is a random forcing \$f\$ and our assumptions allow for an \$f\$ which is white in time and colored in space. Assuming that we control products of the form \$v{\textbackslash}partial\_1{\textasciicircum}2v\$ (next to \$vf\$) with \$v\$ solving the constant-coefficient equation \${\textbackslash}partial\_2 v-a\_0{\textbackslash}partial\_1{\textasciicircum}2v=f\$, we obtain a \$C{\textasciicircum}{\textbackslash}alpha\$-estimate for \$u\$. As a first consequence, we obtain an existence result for space-time periodic solutions and small data. We also demonstrate how the require products can be bounded in the case of a random forcing \$f\$ using stochastic arguments. For this we extend the treatment of the singular product \${\textbackslash}sigma(u)f\$ via a space-time version of Gubinelli's notion of controlled rough paths to the product \$a(u){\textbackslash}partial\_1{\textasciicircum}2u\$, which has the same degree of singularity but is more nonlinear since the solution \$u\$ appears in both factors. The PDE ingredient mimics the (kernel-free) Krylov-Safanov approach to ordinary Schauder theory.},
	urldate = {2016-06-08},
	journal = {arXiv:1605.09744 [math]},
	author = {Otto, F. and Weber, H.},
	month = may,
	year = {2016},
	keywords = {60H15, 35B65, Mathematics - Analysis of PDEs, Mathematics - Probability},
	annote = {Comment: 36 pages},
	file = {arXiv.org Snapshot:/Users/mgubi/Library/Application Support/Zotero/Profiles/fm2dd0ng.default/zotero/storage/6BEIVB4G/1605.html:text/html;Otto and Weber - 2016 - Quasilinear SPDEs via rough paths.pdf:/Users/mgubi/Library/Application Support/Zotero/Profiles/fm2dd0ng.default/zotero/storage/HPI6X8IG/Otto and Weber - 2016 - Quasilinear SPDEs via rough paths.pdf:application/pdf}
}

