@article{bailleul_higher_2016,
	title = {Higher order paracontrolled calculus},
	url = {http://arxiv.org/abs/1609.06966},
	abstract = {We develop in this work a general version of paracontrolled calculus that allows to treat analytically within this paradigm some singular partial differential equations with the same efficiency as regularity structures, with the benefit that there is no need to introduce the algebraic apparatus inherent to the latter theory. This work deals with the analytic side of the story and offers a toolkit for the study of such equations, under the form of a number of continuity results for some operators. We illustrate the efficiency of this elementary approach on the example of the generalised parabolic Anderson model equation \$\$ ({\textbackslash}partial\_t + L) u = f(u){\textbackslash}zeta \$\$ for a spacial 'noise' \${\textbackslash}zeta\$ of H{\textbackslash}"older regularity \${\textbackslash}alpha-2\$, with \${\textbackslash}frac\{2\}\{5\}{\textless} {\textbackslash}alpha {\textbackslash}leq {\textbackslash}frac\{2\}\{3\}\$, and the generalized KPZ equation \$\$ ({\textbackslash}partial\_t + L) u = f(u){\textbackslash}zeta + g(u)({\textbackslash}partial u){\textasciicircum}2, \$\$ in the relatively mild case where \${\textbackslash}frac\{1\}\{2\}{\textless}{\textbackslash}alpha{\textbackslash}leq {\textbackslash}frac\{2\}\{3\}\$.},
	urldate = {2016-10-17},
	journal = {arXiv:1609.06966 [math]},
	author = {Bailleul, I. and Bernicot, F.},
	month = sep,
	year = {2016},
	keywords = {Mathematics - Analysis of PDEs, Mathematics - Classical Analysis and ODEs, Mathematics - Probability},
	annote = {Comment: 61 pages},
	file = {arXiv.org Snapshot:/Users/mgubi/Library/Application Support/Zotero/Profiles/fm2dd0ng.default/zotero/storage/KT67CK3P/1609.html:text/html;Bailleul and Bernicot - 2016 - Higher order paracontrolled calculus.pdf:/Users/mgubi/Library/Application Support/Zotero/Profiles/fm2dd0ng.default/zotero/storage/V7R7NX3T/Bailleul and Bernicot - 2016 - Higher order paracontrolled calculus.pdf:application/pdf}
