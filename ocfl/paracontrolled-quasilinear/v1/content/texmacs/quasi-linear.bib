@article{allez_continuous_2015,
	title = {The continuous {Anderson} hamiltonian in dimension two},
	url = {http://arxiv.org/abs/1511.02718},
	abstract = {We define the Anderson hamiltonian on the two dimensional torus \${\textbackslash}mathbb R{\textasciicircum}2/{\textbackslash}mathbb Z{\textasciicircum}2\$. This operator is formally defined as \${\textbackslash}mathscr H:= -{\textbackslash}Delta + {\textbackslash}xi\$ where \${\textbackslash}Delta\$ is the Laplacian operator and where \${\textbackslash}xi\$ belongs to a general class of singular potential which includes the Gaussian white noise distribution. We use the notion of paracontrolled distribution as introduced by Gubinelli, Imkeller and Perkowski in [14]. We are able to define the Schr{\textbackslash}"odinger operator \${\textbackslash}mathscr H\$ as an unbounded self-adjoint operator on \$L{\textasciicircum}2({\textbackslash}mathbb T{\textasciicircum}2)\$ and we prove that its real spectrum is discrete with no accumulation points for a general class of singular potential \${\textbackslash}xi\$. We also establish that the spectrum is a continuous function of a sort of enhancement \${\textbackslash}Xi({\textbackslash}xi)\$ of the potential \${\textbackslash}xi\$. As an application, we prove that a correctly renormalized smooth approximations \${\textbackslash}mathscr H\_{\textbackslash}varepsilon:= -{\textbackslash}Delta + {\textbackslash}xi\_{\textbackslash}varepsilon+c\_{\textbackslash}varepsilon\$ (where \${\textbackslash}xi\_{\textbackslash}varepsilon\$ is a smooth mollification of the Gaussian white noise \${\textbackslash}xi\$ and \$c\_{\textbackslash}varepsilon\$ an explicit diverging renormalization constant) converge in the sense of the resolvent towards the singular operator \${\textbackslash}mathscr H\$. In the case of a Gaussian white noise \${\textbackslash}xi\$, we obtain exponential tail bounds for the minimal eigenvalue (sometimes called ground state) of the operator \${\textbackslash}mathscr H\$ as well as its order of magnitude \${\textbackslash}log L\$ when the operator is considered on a large box \${\textbackslash}mathbb T\_L:= {\textbackslash}mathbb R{\textasciicircum}2/(L{\textasciicircum}\{-1\}{\textbackslash}mathbb Z{\textasciicircum}2)\$ with \$L{\textbackslash}to {\textbackslash}infty\$.},
	urldate = {2015-11-12},
	journal = {arXiv:1511.02718 [math]},
	author = {Allez, R. and Chouk, K.},
	month = nov,
	year = {2015},
	keywords = {Mathematics - Probability},
	file = {Allez and Chouk - 2015 - The continuous Anderson hamiltonian in dimension t.pdf:/Users/mgubi/Library/Application Support/Zotero/Profiles/fm2dd0ng.default/zotero/storage/29XMKZRE/Allez and Chouk - 2015 - The continuous Anderson hamiltonian in dimension t.pdf:application/pdf;arXiv.org Snapshot:/Users/mgubi/Library/Application Support/Zotero/Profiles/fm2dd0ng.default/zotero/storage/7PGHCNNP/1511.html:text/html}
}

