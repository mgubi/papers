@article{hairer_support_2022,
	title = {The support of singular stochastic partial differential equations},
	volume = {10},
	issn = {2050-5086},
	url = {https://www.cambridge.org/core/product/identifier/S2050508621000184/type/journal_article},
	doi = {10.1017/fmp.2021.18},
	abstract = {We obtain a generalisation of the Stroock–Varadhan support theorem for a large class of systems of subcritical singular stochastic partial diﬀerential equations driven by a noise that is either white or approximately self-similar. The main problem that we face is the presence of renormalisation. In particular, it may happen in general that diﬀerent renormalisation procedures yield solutions with diﬀerent supports. One of the main steps in our construction is the identiﬁcation of a subgroup H of the renormalisation group such that any renormalisation procedure determines a unique coset 𝑔 ◦ H. The support of the solution then depends only on this coset and is obtained by taking the closure of all solutions obtained by replacing the driving noises by smooth functions in the equation that is renormalised by some element of 𝑔 ◦ H.},
	language = {en},
	urldate = {2024-01-02},
	journal = {Forum of Mathematics, Pi},
	author = {Hairer, Martin and Schönbauer, Philipp},
	year = {2022},
	pages = {e1},
	file = {Hairer and Schönbauer - 2022 - The support of singular stochastic partial differe.pdf:/Users/paulovics/Zotero/storage/GI9UGEKJ/Hairer and Schönbauer - 2022 - The support of singular stochastic partial differe.pdf:application/pdf},
}

