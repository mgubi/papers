@article{brandt1967,
title = {Derivation of renormalized relativistic perturbation theory from finite local field equations},
journal = {Annals of Physics},
volume = {44},
number = {2},
pages = {221-265},
year = {1967},
issn = {0003-4916},
doi = {https://doi.org/10.1016/0003-4916(67)90177-7},
url = {https://www.sciencedirect.com/science/article/pii/0003491667901777},
author = {Richard A Brandt},
abstract = {In this paper we investigate an hypothesis of K. Wilson for the behavior of a product of an arbitrary number of interacting field operators, when evaluated near the same point. The hypothesis suggests that an appropriate field equation for neutral pseudoscalar meson theory is (iγ·∂ − m)ψ(x) = iglimξ→0E3−1(ξ)[ψ(x)ϵ(x − ψ) − E1(ξ)ψ(x) − E2μ(ξ)∂μψ(x)] for suitable functions Ei(ξ) with singularities at ξ = 0. We show that Ei exist such that the renormalized integral equations implied by this equation are valid in all orders of renormalized perturbation theory. Since the iterative solutions of these integral equations are equivalent to conventional perturbation theory, it follows that this theory can be based on finite field equations. We explicitly exhibit a suitable set of Ei's in terms of renormalized Green's functions and show that different sets correspond to finite renormalizations of the relavent parameters. Our work is based on rigorously proved properties of renormalization theory and is applicable to any renormalizable field theory.}
}

