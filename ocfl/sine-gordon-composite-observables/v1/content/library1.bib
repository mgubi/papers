@article{frob2025,
author={Fr{\"o}b, Markus
and Cadamuro, Daniela},
title={Local Operators in the Sine-Gordon Model: $$\partial_\mu \phi\partial_\nu\phi$$ and the Stress Tensor},
journal={Annales Henri Poincar{\'e}},
year={2025},
month={Apr},
day={16},
abstract={We consider the simplest non-trivial local composite operators in the massless Sine-Gordon model, which are {\$}{\$}{\backslash}partial {\_}{\backslash}mu {\backslash}phi {\backslash}, {\backslash}partial {\_}{\backslash}nu {\backslash}phi {\$}{\$}and the stress tensor {\$}{\$}T{\_}{\{}{\backslash}mu {\backslash}nu {\}}{\$}{\$}. We show that even in the finite regime {\$}{\$}{\backslash}beta ^2 < 4 {\backslash}pi {\$}{\$}of the theory, these operators need additional renormalisation (beyond the free-field normal-ordering) at each order in perturbation theory. We further prove convergence of the renormalised perturbative series for their expectation values, both in the Euclidean signature and in Minkowski spacetime, and for the latter in an arbitrary Hadamard state. Lastly, we show that one must add a quantum correction (proportional to {\$}{\$}{\backslash}hbar {\$}{\$}) to the renormalised stress tensor to obtain a conserved quantity.},
issn={1424-0661},
