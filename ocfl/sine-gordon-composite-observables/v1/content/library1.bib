@Article{dimock2000,
author={Dimock, J.
and Hurd, T. R.},
title={Sine-Gordon Revisited},
journal={Annales Henri Poincar{\'e}},
year={2000},
month={Jul},
day={01},
volume={1},
number={3},
pages={499-541},
abstract={We study the sine-Gordon model in two dimensional space time in two different domains. For $\beta$ > 8$\pi$ and weak coupling, we introduce an ultraviolet cutoff and study the infrared behavior. A renormalization group analysis shows that the model is asymptotically free in the infrared. For $\beta$ < 8$\pi$ and weak coupling, we introduce an infrared cutoff and study the ultraviolet behavior. A renormalization group analysis shows that the model is asymptotically free in the ultraviolet.},
