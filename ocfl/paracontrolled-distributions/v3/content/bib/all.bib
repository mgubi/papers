	Keywords = {Computational Finance; Probability},
	Month = {apr},
	Title = {{A Direct Proof of the Bichteler-Dellacherie Theorem and Connections to Arbitrage}},
	Url = {http://arxiv.org/abs/1004.5559},
	Year = {2010},
