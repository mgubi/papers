@article{Kella2010,
	Abstract = {We give a representation of the solution for a stochastic linear equation of the form \$X\_t=Y\_t+\backslash int\_\{(0,t]\}X\_\{s-\} \backslash mathrm \{d\}\{Z\}\_s\$ where \$Z\$ is a c$\backslash$'adl$\backslash$'ag semimartingale and \$Y\$ is a c$\backslash$'adl$\backslash$'ag adapted process with bounded variation on finite intervals. As an application we study the case where \$Y\$ and \$-Z\$ are nondecreasing, jointly have stationary increments and the jumps of \$-Z\$ are bounded by 1. Special cases of this process are shot-noise processes, growth collapse (additive increase, multiplicative decrease) processes and clearing processes. When \$Y\$ and \$Z\$ are, in addition, independent L$\backslash$'evy processes, the resulting \$X\$ is called a generalized Ornstein-Uhlenbeck process.},
