@article{Gael2011,
	Abstract = {Let \$X\$ be a stationary process with values in some \$\backslash sigma\$-finite measured state space \$(E,\backslash mathcal\{E\},\backslash pi)\$, indexed by \$\backslash Z\$. Call \$\backslash F\^{}X\$ its natural filtration. In $\backslash$cite\{ceillierstationary\}, sufficient conditions were given for \$\backslash F\^{}X\$ to be standard when \$E\$ is finite. The proof of this result used a coupling of all probabilities on the finite set \$E\$. In this paper, we construct a coupling of all laws having a density with regard to \$\backslash pi\$, which is much more involved. Then, we provide sufficient conditions for \$\backslash F\^{}X\$ to be standard, generalizing those in $\backslash$cite\{ceillierstationary\}.},
