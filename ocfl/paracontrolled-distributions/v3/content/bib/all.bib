@article{Berti2010,
	Abstract = {Let \$L\$ be a linear space of real bounded random variables on the probability space \$(\backslash Omega,\backslash mathcal\{A\},P\_0)\$. There is a finitely additive probability \$P\$ on \$\backslash mathcal\{A\}\$, such that \$P\backslash sim P\_0\$ and \$E\_P(X)=0\$ for all \$X\backslash in L\$, if and only if \$c\backslash,E\_Q(X)\backslash leq\backslash text\{ess sup\}(-X)\$, \$X\backslash in L\$, for some constant \$c>0\$ and (countably additive) probability \$Q\$ on \$\backslash mathcal\{A\}\$ such that \$Q\backslash sim P\_0\$. A necessary condition for such a \$P\$ to exist is \$\backslash bar\{L-L\_\backslash infty\^{}+\}\backslash,\backslash cap L\_\backslash infty\^{}+=\backslash\{0\backslash\}\$, where the closure is in the norm-topology. If \$P\_0\$ is atomic, the condition is sufficient as well. In addition, there is a finitely additive probability \$P\$ on \$\backslash mathcal\{A\}\$, such that \$P\backslash ll P\_0\$ and \$E\_P(X)=0\$ for all \$X\backslash in L\$, if and only if \$\backslash text\{ess sup\}(X)\backslash geq 0\$ for all \$X\backslash in L\$.},
