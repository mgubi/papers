@article{Kramkov2011,
	Abstract = {Let \$\backslash mathbb\{Q\}\$ and \$\backslash mathbb\{P\}\$ be equivalent probability measures and let \$\backslash psi\$ be a \$J\$-dimensional vector of random variables such that \$\backslash frac\{d\backslash mathbb\{Q\}\}\{d\backslash mathbb\{P\}\}\$ and \$\backslash psi\$ are defined in terms of a weak solution \$X\$ to a \$d\$-dimensional stochastic differential equation. Motivated by the problem of $\backslash$emph\{endogenous completeness\} in financial economics we present conditions which guarantee that any local martingale under \$\backslash mathbb\{Q\}\$ is a stochastic integral with respect to the \$J\$-dimensional martingale \$S\_t \backslash set \backslash mathbb\{E\}\^{}\{\backslash mathbb\{Q\}\}[\backslash psi|\backslash mathcal\{F\}\_t]\$. While the drift \$b=b(t,x)\$ and the volatility \$\backslash sigma = \backslash sigma(t,x)\$ coefficients for \$X\$ need to have only minimal regularity properties with respect to \$x\$, they are assumed to be analytic functions with respect to \$t\$. We provide a counter-example showing that this \$t\$-analyticity assumption for \$\backslash sigma\$ cannot be removed.},
