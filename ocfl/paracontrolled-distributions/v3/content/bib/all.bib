@article{Ma2011,
	Abstract = {In this paper we study the wellposedness of the forward-backward stochastic differential equations (FBSDE) in a general non-Markovian framework. The main purpose is to find a unified scheme which combines all existing methodology in the literature, and to overcome some fundamental difficulties that have been longstanding problems for non-Markovian FBSDEs. Our main devices are a \{$\backslash$it decoupling random field\} and its associated \{$\backslash$it characteristic BSDE\}, a backward stochastic Riccati-type equation with superlinear growth in both components \$Y\$ and \$Z\$. We establish various sufficient conditions under which the characteristic BSDE is wellposed, which leads to the existence of the decoupling random field, and ultimately to the solvability of the original FBSDE. We show that all existing frameworks could be analyzed using our new criteria.},
	Archiveprefix = {arXiv},
	Arxivid = {1110.4658},
	Author = {Ma, Jin and Wu, Zhen and Zhang, Detao and Zhang, Jianfeng},
	Eprint = {1110.4658},
