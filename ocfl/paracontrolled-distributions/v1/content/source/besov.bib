	doi = "10.1016/j.anihpc.2010.11.002",
	file = "Caruana et al. - 2011 - A (rough) pathwise approach to a class of non-line.pdf:/Users/Mgubi/Library/Application Support/Zotero/Profiles/66gcx4j4.default/zotero/storage/A3CDWG67/Caruana et al. - 2011 - A (rough) pathwise approach to a class of non-line.pdf:application/pdf;ScienceDirect Snapshot:/Users/Mgubi/Library/Application Support/Zotero/Profiles/66gcx4j4.default/zotero/storage/3FE28IBI/Caruana et al. - 2011 - A (rough) pathwise approach to a class of non-line.html:text/html",
	issn = "0294-1449",
	journal = "Annales de {l'Institut} Henri Poincare {(C)} Non Linear Analysis",
	keywords = "Parabolic viscosity {PDEs}; Rough path theory; Stochastic {PDEs}",
	month = jan,
